# ─────────────────────────────────────────────────────────────────────────────
# Higgins Helper environment variables
#
# Local dev:  copy this file to .env.local and fill in the values.
# Render:     set these under the service's Environment tab (render.yaml
#             declares them, so the Blueprint prompts for them on creation).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web config (REQUIRED) ───────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → Config.
# These are baked into the frontend bundle at BUILD time by Vite. On Render,
# changing one means redeploying, not just restarting.
# They are not secrets (every browser that loads the app receives them); access
# to user data is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled on the Firebase project.
# VITE_FIREBASE_MEASUREMENT_ID=

# ── Server (optional) ────────────────────────────────────────────────────────
# Port the Express server listens on. Render sets this automatically; do not
# set it there. Defaults to 3001 locally (Vite proxies /api to it).
# PORT=3001

# "production" makes the server serve the built frontend from dist/.
# `npm start` sets it for you locally; render.yaml sets it on Render.
# NODE_ENV=production

# Allowed origin for cross-origin API calls. Only matters if the frontend is
# served from a different origin than the API — not the case on Render, where
# one service serves both. Defaults to http://localhost:5173.
# CORS_ORIGIN=http://localhost:5173

# ── AI nutritionist (optional) ───────────────────────────────────────────────
# Google AI Studio → Get API key. Server-side only: it is read at runtime by
# the Express server and never sent to the browser. Without it the server
# still starts, but the AI Advisor chat returns errors and the dashboard's AI
# blurb is left out.
# GEMINI_API_KEY=
