# ─── HigginsHelper — Environment Variables Template ──────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is git-ignored.
#
# .env          → Read by the Node/Express backend server (via dotenv)
# .env.local    → Read by the Vite frontend (VITE_* vars only)
# .env.example  → Safe to commit — contains NO real secrets
# ──────────────────────────────────────────────────────────────────────────────


# ─── Backend (server/.env or root .env) ──────────────────────────────────────

# Google Gemini API key — required for the /api/ai/chat endpoint.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Express server port (optional — defaults to 3001)
# PORT=3001


# ─── Frontend (Vite) — root .env.local ───────────────────────────────────────
#
# NOTE: The frontend uses a Vite reverse-proxy for /api/* requests in dev mode,
# so VITE_API_BASE_URL is informational only and is NOT used in production.
# The proxy target is hardcoded in vite.config.ts → server.proxy["/api"].
#
# VITE_API_BASE_URL=http://localhost:3001

# Firebase — required for Auth + Firestore (client-side SDK)
# Get these from: Firebase Console → Project Settings → Your Apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
